[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=ios-to-sailfish
Exec=sailfish-qml ios-to-sailfish
Name=iOS to Sailfish

[X-Sailjail]
OrganizationName=fr.gwilhermbaudic
ApplicationName=ios-to-sailfish
# A lot of permissions asked here:
# * Calendar, CommunicationHistory, Contacts, Documents, Messages, Pictures, Videos: to add migrated data at its place
# * MediaIndexing: just in case because we will add pictures and videos
# * Downloads, RemovableMedia: to access the backup
Permissions=Calendar;CommunicationHistory;Contacts;Documents;Downloads;MediaIndexing;Messages;Pictures;RemovableMedia;Videos
